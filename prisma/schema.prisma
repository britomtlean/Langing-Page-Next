generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type PedidosProdutos {
  Nome          String
  ProdutoId     String
  Quantidade    Int
  Subtotal      Float
  ValorUnitario Float
}

model Pedidos {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  ContatoCliente  String
  DataPedido      DateTime          @db.Date
  EnderecoCliente String
  NomeCliente     String
  Produtos        PedidosProdutos[]
  Status          Boolean?
  StatusEntrega   String?
  ValorTotal      Float
}

model Produtos {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  categoria       String?
  data_criacao    DateTime @db.Date
  descricao       String
  disponibilidade Boolean
  estoque         Int
  imagem          String
  login           String
  nome            String
  valor           Float
}

model Promocoes {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  descricao        String
  enderecoDaImagem String
  login            String
  visibilidade     Boolean
}

model Usuarios {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  Descricao String
  Endereco  String
  Horario   String
  Instagram String
  Logo      String?
  Nome      String
  Senha     String
  WhatsApp  String
  user      String @unique
}
