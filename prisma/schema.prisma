generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type PedidosProdutos {
  Nome          String
  ProdutoId     String
  Quantidade    Int
  Subtotal      Float
  ValorUnitario Float
}

model Pedidos {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  ContatoCliente  String
  DataPedido      DateTime          @db.Date
  EnderecoCliente String
  NomeCliente     String
  Produtos        PedidosProdutos[]
  Status          Boolean
  /// Could not determine type: the field only had null or empty values in the sample set.
  StatusEntrega   Json?
  ValorTotal      Float
}

model Produtos {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  categoria       String?
  cpf             String
  data_criacao    DateTime @db.Date
  descricao       String
  disponibilidade Boolean
  estoque         Int
  imagem          String
  nome            String
  valor           Float
}

model Usuarios {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  Cpf   String?
  Nome  String?
  Senha String?
}
